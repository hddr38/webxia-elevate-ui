# Supabase (required) — ne jamais mettre de vraies clés ici, copier vers .env en local
VITE_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=VOTRE_ANON_KEY_ICI
SUPABASE_SERVICE_ROLE_KEY=VOTRE_SERVICE_ROLE_KEY_ICI

# NVIDIA NIM (required for Webi)
NVIDIA_NIM_API_KEY=nvapi-VOTRE_CLE_ICI
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# NVIDIA NIM embedding model (RAG + ai_memory share this single model;
# dimensions stay controlled by EmbeddingConfig, never by env)
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# AI Fallback (optional) — NVIDIA_NIM_FALLBACK_MODEL is the single source for the fallback model
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=nvidia

# AI Limits (optional)
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4096

# Chat lifecycle (server) — total request deadline, clamped 5000..300000.
# MUST stay > LLM TTFB budget (45s in chat.ts) or the lifecycle kills the
# request before provider timeout → fallback can never engage.
CHAT_REQUEST_TIMEOUT_MS=110000
# SSE keep-alive (server) - idle gap between heartbeat frames, clamped 250..60000.
# Keeps proxies/CDNs from dropping a silent stream while the model thinks.
CHAT_HEARTBEAT_MS=15000
