{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/start.ts",
    "src/server.ts",
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    "src/server/functions/**/*.{ts,tsx}",
    "scripts/ingest-knowledge.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/routeTree.gen.ts",
    "supabase/**",
    "e2e/**",
    "public/**",
    ".github/**"
  ],
  "ignoreDependencies": ["nitro", "lightningcss", "tw-animate-css"]
}
